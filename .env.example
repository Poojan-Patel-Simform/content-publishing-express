# --- Runtime ---
NODE_ENV=development
PORT=3000


# --- Database ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>?schema=public

# --- CORS ---
# Comma-separated allowlist of browser origins. Empty means no cross-origin
# browser request is permitted. Never use a wildcard here.
CORS_ORIGINS=http://localhost:5173

# --- Logging ---
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Stricter bucket for credential endpoints (login, signup, password reset).
AUTH_RATE_LIMIT_MAX=10

# --- Request limits ---
BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000
