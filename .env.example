# --- Runtime ---
NODE_ENV=development
PORT=3000


# --- Database ---
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_PORT=

DATABASE_URL=postgresql://<POSTGRES_USER>:<POSTGRES_PASSWORD>@localhost:<POSTGRES_PORT>/<POSTGRES_DB>?schema=public

# --- CORS ---
# Comma-separated allowlist of browser origins. Empty means no cross-origin
# browser request is permitted. Never use a wildcard here.
CORS_ORIGINS=http://localhost:5173

# --- Logging ---
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
# Stricter bucket for credential endpoints (login, signup, password reset).
AUTH_RATE_LIMIT_MAX=10

# --- Request limits ---
BODY_LIMIT=1mb
SHUTDOWN_TIMEOUT_MS=10000

# --- App / URLs ---
APP_NAME=Content Publishing
FRONTEND_URL=http://localhost:5173
API_PUBLIC_URL=http://localhost:3000
# Number of reverse-proxy hops in front of this process, not a boolean.
TRUST_PROXY=0

# --- JWT ---
# Must be at least 32 characters.
JWT_SECRET=
JWT_ISSUER=content-publishing-api
JWT_AUDIENCE=content-publishing-web
ACCESS_TOKEN_TTL_S=900
REFRESH_TOKEN_TTL_DAYS=30
REFRESH_REUSE_GRACE_MS=10000

# --- Cookies ---
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# COOKIE_DOMAIN=

# --- Password / token lifetimes ---
PASSWORD_MIN_LENGTH=12
EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

# --- OAuth (blank = provider disabled) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=
OAUTH_STATE_TTL_MS=600000

# --- Mail ---
# smtp | log -- log prints the verification/reset links to the server log
# instead of sending real mail.
MAIL_TRANSPORT=log
MAIL_FROM=Content Publishing <no-reply@localhost>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false

# --- Jobs ---
SESSION_CLEANUP_INTERVAL_MS=3600000
SCHEDULE_MIN_LEAD_MS=30000

# --- Scheduled publishing (BullMQ) ---
REDIS_URL=redis://localhost:6379
SCHEDULER_ENABLED=true
SCHEDULER_CONCURRENCY=5
SCHEDULER_MAX_ATTEMPTS=5
SCHEDULER_BACKOFF_MS=30000
SCHEDULER_RECONCILE_INTERVAL_MS=60000
